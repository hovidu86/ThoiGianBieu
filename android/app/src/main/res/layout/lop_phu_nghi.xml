<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/nghi_bat_buoc"
        android:textColor="@color/xanh"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dem_nghi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:letterSpacing="-0.04"
        android:text="--:--"
        android:textColor="@color/chu"
        android:textSize="76sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/loi_nhac"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/chu_mo"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/thong_ke_nghi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:background="@drawable/the"
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp"
        android:textColor="@color/chu_rat_mo"
        android:textSize="13sp" />

    <Button
        android:id="@+id/nut_khan_cap"
        style="@style/NutPhu"
        android:layout_width="wrap_content"
        android:layout_marginTop="26dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
