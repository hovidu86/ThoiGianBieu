<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ten_app"
            android:textColor="@color/chu"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phu_de"
            android:textColor="@color/chu_rat_mo"
            android:textSize="13sp" />

        <!-- Tình trạng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/nhan_tinh_trang"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tinh_trang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/nen_the"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:textColor="@color/chu"
            android:textSize="14sp" />

        <!-- Quyền -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/nhan_quyen"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <Button
            android:id="@+id/nut_quyen_quan_tri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/nen_o"
            android:text="@string/nut_quyen_quan_tri"
            android:textColor="@color/chu" />

        <Button
            android:id="@+id/nut_quyen_lop_phu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/nen_o"
            android:text="@string/nut_quyen_lop_phu"
            android:textColor="@color/chu" />

        <Button
            android:id="@+id/nut_quyen_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/nen_o"
            android:text="@string/nut_quyen_pin"
            android:textColor="@color/chu" />

        <!-- Giờ giấc -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/nhan_gio_khoa"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_gio_khoa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="datetime"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/nhan_gio_ket_thuc"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_gio_ket_thuc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="datetime"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/nhan_lap_lai"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_lap_lai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/nhan_canh_bao"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_canh_bao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/nhan_khoang_cach"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_khoang_cach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <!-- ============ DÙNG NGẮT QUÃNG ============ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:background="@color/nen_o" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/nq_tieu_de"
            android:textColor="@color/chu"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nq_giai_thich"
            android:textColor="@color/chu_rat_mo"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/chk_nq_bat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/nq_bat"
            android:textColor="@color/chu"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/nhan_nq_phut_dung"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_nq_phut_dung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/nhan_nq_phut_nghi"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_nq_phut_nghi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/nhan_nq_phut_reset"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_nq_phut_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/nhan_nq_canh_bao"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_nq_canh_bao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/nhan_nq_khung_gio"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/o_nq_tu_gio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/nen_o"
                android:hint="@string/nhan_nq_tu_gio"
                android:importantForAutofill="no"
                android:inputType="datetime"
                android:padding="12dp"
                android:textColor="@color/chu"
                android:textColorHint="@color/chu_rat_mo" />

            <EditText
                android:id="@+id/o_nq_den_gio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@color/nen_o"
                android:hint="@string/nhan_nq_den_gio"
                android:importantForAutofill="no"
                android:inputType="datetime"
                android:padding="12dp"
                android:textColor="@color/chu"
                android:textColorHint="@color/chu_rat_mo" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/nhan_nq_khan_cap"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_nq_khan_cap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <CheckBox
            android:id="@+id/chk_nq_khong_khoa_khi_goi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/nq_khong_khoa_khi_goi"
            android:textColor="@color/chu"
            android:textSize="14sp" />

        <!-- Mã -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:background="@color/nen_o" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/nhan_ma"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/o_ma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <EditText
            android:id="@+id/o_ma_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/nen_o"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/chu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/goi_y_ma"
            android:textColor="@color/chu_rat_mo"
            android:textSize="12sp" />

        <Button
            android:id="@+id/nut_luu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/xanh"
            android:text="@string/nut_luu"
            android:textColor="@color/chu" />

        <Button
            android:id="@+id/nut_khoa_thu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/nen_o"
            android:text="@string/nut_khoa_thu"
            android:textColor="@color/chu" />

        <Button
            android:id="@+id/nut_thong_ke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/nen_o"
            android:text="@string/nut_thong_ke"
            android:textColor="@color/chu" />

        <Button
            android:id="@+id/nut_nhat_ky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/nen_o"
            android:text="@string/nut_nhat_ky"
            android:textColor="@color/chu" />
    </LinearLayout>
</ScrollView>
