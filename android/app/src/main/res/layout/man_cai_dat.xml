<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/goc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/dau_trang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dau_trang"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="14dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ten_app"
            android:textColor="@color/xanh"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phu_de"
            android:textColor="@color/chu_mo"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/cuon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="11dp"
        android:paddingTop="10dp"
        android:paddingRight="11dp"
        android:paddingBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tình trạng + quyền -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/the"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    style="@style/Nhom"
                    android:text="@string/nhan_tinh_trang" />

                <TextView
                    android:id="@+id/tinh_trang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/the_trong"
                    android:lineSpacingExtra="5dp"
                    android:padding="12dp"
                    android:textColor="@color/chu"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/nhan_quyen"
                    android:textColor="@color/chu_rat_mo"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/nut_quyen_quan_tri"
                    style="@style/NutPhu"
                    android:layout_marginTop="8dp"
                    android:text="@string/nut_quyen_quan_tri" />

                <Button
                    android:id="@+id/nut_quyen_lop_phu"
                    style="@style/NutPhu"
                    android:layout_marginTop="6dp"
                    android:text="@string/nut_quyen_lop_phu" />

                <Button
                    android:id="@+id/nut_quyen_pin"
                    style="@style/NutPhu"
                    android:layout_marginTop="6dp"
                    android:text="@string/nut_quyen_pin" />
            </LinearLayout>

            <!-- Khoá theo giờ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/the"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    style="@style/Nhom"
                    android:text="@string/nhom_khoa_theo_gio" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Nhan"
                            android:text="@string/nhan_gio_khoa_ngan" />

                        <TextView
                            android:id="@+id/o_gio_khoa"
                            style="@style/O"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Nhan"
                            android:text="@string/nhan_gio_ket_thuc_ngan" />

                        <TextView
                            android:id="@+id/o_gio_ket_thuc"
                            style="@style/O"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Nhan"
                    android:layout_marginTop="11dp"
                    android:text="@string/nhan_lap_lai" />

                <EditText
                    android:id="@+id/o_lap_lai"
                    style="@style/O"
                    android:inputType="number" />

                <TextView
                    style="@style/Nhan"
                    android:layout_marginTop="11dp"
                    android:text="@string/nhan_canh_bao" />

                <EditText
                    android:id="@+id/o_canh_bao"
                    style="@style/O"
                    android:inputType="phone" />

                <TextView
                    style="@style/Nhan"
                    android:layout_marginTop="11dp"
                    android:text="@string/nhan_khoang_cach" />

                <EditText
                    android:id="@+id/o_khoang_cach"
                    style="@style/O"
                    android:inputType="number" />
            </LinearLayout>

            <!-- Dùng ngắt quãng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/the"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    style="@style/Nhom"
                    android:text="@string/nq_tieu_de" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/nq_giai_thich"
                    android:textColor="@color/chu_rat_mo"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/chk_nq_bat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/nq_bat"
                    android:textColor="@color/chu"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Nhan"
                            android:text="@string/nhan_nq_phut_dung_ngan" />

                        <EditText
                            android:id="@+id/o_nq_phut_dung"
                            style="@style/O"
                            android:gravity="center"
                            android:inputType="number" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Nhan"
                            android:text="@string/nhan_nq_phut_nghi_ngan" />

                        <EditText
                            android:id="@+id/o_nq_phut_nghi"
                            style="@style/O"
                            android:gravity="center"
                            android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Nhan"
                            android:text="@string/nhan_nq_phut_reset_ngan" />

                        <EditText
                            android:id="@+id/o_nq_phut_reset"
                            style="@style/O"
                            android:gravity="center"
                            android:inputType="number" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Nhan"
                            android:text="@string/nhan_nq_canh_bao_ngan" />

                        <EditText
                            android:id="@+id/o_nq_canh_bao"
                            style="@style/O"
                            android:gravity="center"
                            android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Nhan"
                    android:layout_marginTop="11dp"
                    android:text="@string/nhan_nq_khung_gio" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/o_nq_tu_gio"
                        style="@style/O"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/o_nq_den_gio"
                        style="@style/O"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center" />
                </LinearLayout>

                <TextView
                    style="@style/Nhan"
                    android:layout_marginTop="11dp"
                    android:text="@string/nhan_nq_khan_cap" />

                <EditText
                    android:id="@+id/o_nq_khan_cap"
                    style="@style/O"
                    android:inputType="number" />

                <CheckBox
                    android:id="@+id/chk_nq_khong_khoa_khi_goi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/nq_khong_khoa_khi_goi"
                    android:textColor="@color/chu"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Mã mở khoá -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/the"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    style="@style/Nhom"
                    android:text="@string/nhan_ma" />

                <EditText
                    android:id="@+id/o_ma"
                    style="@style/O"
                    android:layout_marginTop="10dp"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/o_ma_2"
                    style="@style/O"
                    android:layout_marginTop="6dp"
                    android:inputType="textPassword" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/goi_y_ma"
                    android:textColor="@color/chu_rat_mo"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/nut_luu"
                style="@style/NutChinh"
                android:layout_marginTop="14dp"
                android:text="@string/nut_luu" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/nut_khoa_thu"
                    style="@style/NutPhu"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/nut_khoa_thu" />

                <Button
                    android:id="@+id/nut_thong_ke"
                    style="@style/NutPhu"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/nut_thong_ke" />
            </LinearLayout>

            <Button
                android:id="@+id/nut_nhat_ky"
                style="@style/NutPhu"
                android:layout_marginTop="6dp"
                android:text="@string/nut_nhat_ky" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
