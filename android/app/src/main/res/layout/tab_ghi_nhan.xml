<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Quỹ và chuỗi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/nen_the"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quy_thuong_phat"
                    android:textColor="@color/chu_rat_mo"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ui_so_du"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ₫"
                    android:textColor="@color/xanh_la"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@color/nen_the"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chuoi_ky_luat"
                    android:textColor="@color/chu_rat_mo"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ui_chuoi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/vang"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Đếm ngược tới giờ mục tiêu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/nen_the"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/dem_nhan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chu_rat_mo"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/dem_chinh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/chu"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chuẩn bị ngủ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/nen_the"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tieu_de_buoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chuan_bi_ngu"
                android:textColor="@color/chu"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ds_buoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/goi_y_buoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/chu_rat_mo"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Ghi nhận -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/nen_the"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ghi_nhan_dem"
                android:textColor="@color/chu"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/nhan_dem"
                android:textColor="@color/chu_mo"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/o_dem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/nen_o"
                android:importantForAutofill="no"
                android:inputType="date"
                android:padding="12dp"
                android:textColor="@color/chu" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nhan_gio_len_giuong"
                        android:textColor="@color/chu_mo"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/o_gio_ngu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/nen_o"
                        android:importantForAutofill="no"
                        android:inputType="datetime"
                        android:padding="12dp"
                        android:textColor="@color/chu"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nhan_gio_day"
                        android:textColor="@color/chu_mo"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/o_gio_day"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/nen_o"
                        android:importantForAutofill="no"
                        android:inputType="datetime"
                        android:padding="12dp"
                        android:textColor="@color/chu"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Xem trước thưởng/phạt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/nen_o"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/xem_truoc_loi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/chon_gio_de_xem"
                    android:textColor="@color/chu"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/xem_truoc_them"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/chu_rat_mo"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/xem_truoc_tien"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="--"
                    android:textColor="@color/chu"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/nut_bay_gio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/nen_o"
                    android:text="@string/nut_bay_gio"
                    android:textColor="@color/chu" />

                <Button
                    android:id="@+id/nut_xac_nhan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/xanh"
                    android:text="@string/nut_xac_nhan"
                    android:textColor="@color/chu" />
            </LinearLayout>
        </LinearLayout>

        <!-- Gần đây -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/gan_day"
            android:textColor="@color/chu_mo"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/ds_gan_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
