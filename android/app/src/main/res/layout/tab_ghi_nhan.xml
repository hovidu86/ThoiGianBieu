<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingLeft="11dp"
    android:paddingTop="10dp"
    android:paddingRight="11dp"
    android:paddingBottom="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Quỹ và chuỗi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/the"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    style="@style/Nhom"
                    android:text="@string/quy_thuong_phat" />

                <TextView
                    android:id="@+id/ui_so_du"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="-0.03"
                    android:text="0 ₫"
                    android:textColor="@color/xanh_la"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/the"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    style="@style/Nhom"
                    android:text="@string/chuoi_ky_luat" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ui_chuoi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.03"
                        android:text="0"
                        android:textColor="@color/vang"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="3dp"
                        android:text="@string/ngay"
                        android:textColor="@color/chu_mo"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Đêm nay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/the"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                android:id="@+id/dem_nhan"
                style="@style/Nhom"
                android:text="@string/dem_nay" />

            <TextView
                android:id="@+id/dem_chinh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="-0.02"
                android:text="--"
                android:textColor="@color/chu"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dem_phu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/chu_mo"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Chuẩn bị ngủ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/the"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                android:id="@+id/tieu_de_buoc"
                style="@style/Nhom"
                android:text="@string/chuan_bi_ngu" />

            <LinearLayout
                android:id="@+id/ds_buoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/goi_y_buoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/chu_rat_mo"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Ghi nhận -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/the"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                style="@style/Nhom"
                android:text="@string/ghi_nhan_dem" />

            <TextView
                style="@style/Nhan"
                android:layout_marginTop="11dp"
                android:text="@string/nhan_dem" />

            <TextView
                android:id="@+id/o_dem"
                style="@style/O"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Nhan"
                        android:text="@string/nhan_gio_len_giuong" />

                    <TextView
                        android:id="@+id/o_gio_ngu"
                        style="@style/O"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:hint="@string/mau_gio"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Nhan"
                        android:text="@string/nhan_gio_day" />

                    <TextView
                        android:id="@+id/o_gio_day"
                        style="@style/O"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:hint="@string/mau_gio"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Xem trước thưởng/phạt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/the_trong"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/xem_truoc_loi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/chon_gio_de_xem"
                    android:textColor="@color/chu"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/xem_truoc_them"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/chu_rat_mo"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/xem_truoc_tien"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="-0.03"
                    android:text="--"
                    android:textColor="@color/chu"
                    android:textSize="27sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/nut_bay_gio"
                    style="@style/NutPhu"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/nut_bay_gio" />

                <Button
                    android:id="@+id/nut_xac_nhan"
                    style="@style/NutChinh"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/nut_xac_nhan" />
            </LinearLayout>
        </LinearLayout>

        <!-- Gần đây -->
        <TextView
            style="@style/Nhom"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="8dp"
            android:text="@string/gan_day" />

        <LinearLayout
            android:id="@+id/ds_gan_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
