<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen"
    android:orientation="vertical">

    <!-- Đầu trang: tên app và tình trạng đồng bộ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nen_the"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingTop="14dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ten_day_du"
                android:textColor="@color/chu"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phu_de"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chu_rat_mo"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chip_dong_bo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/nen_o"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp"
            android:text="@string/chua_ket_noi"
            android:textColor="@color/chu_mo"
            android:textSize="12sp" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/trang"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/tab_ghi_nhan" />
        <include layout="@layout/tab_thong_ke" />
        <include layout="@layout/tab_cai_dat_ngu" />
    </ViewFlipper>

    <!-- Thanh chuyển tab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nen_the"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tab_ghi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="@string/tab_ghi_nhan"
            android:textColor="@color/chu"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tab_thong_ke"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="@string/tab_thong_ke"
            android:textColor="@color/chu_mo"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tab_cai_dat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="@string/tab_cai_dat"
            android:textColor="@color/chu_mo"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tab_may"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="@string/tab_may"
            android:textColor="@color/chu_mo"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
