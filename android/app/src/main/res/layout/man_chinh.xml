<?xml version="1.0" encoding="utf-8"?>
<!--
  Khung ngoài. Phần đệm cho thanh trạng thái và thanh điều hướng của hệ thống
  do ChinhActivity bơm vào lúc chạy (xem donInsets): từ Android 15, app nhắm
  SDK 35 trở lên luôn vẽ tràn ra sau thanh trạng thái, không tự né được.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/goc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen"
    android:orientation="vertical">

    <!-- Đầu trang -->
    <LinearLayout
        android:id="@+id/dau_trang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dau_trang"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:text="@string/ten_day_du"
                android:textColor="@color/xanh"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phu_de"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/chu_mo"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chip_dong_bo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:text="@string/chua_ket_noi"
            android:textColor="@color/chu_mo"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/trang"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/tab_ghi_nhan" />
        <include layout="@layout/tab_thong_ke" />
        <include layout="@layout/tab_cai_dat_ngu" />
        <include layout="@layout/tab_kiem_soat" />
    </ViewFlipper>

    <!-- Thanh điều hướng -->
    <LinearLayout
        android:id="@+id/thanh_duoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/thanh_duoi"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_ghi"
            style="@style/MucTab">

            <TextView
                android:id="@+id/tab_ghi_hinh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hinh_ghi_nhan"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tab_ghi_chu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_ghi_nhan"
                android:textColor="@color/chu_mo"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_thong_ke"
            style="@style/MucTab">

            <TextView
                android:id="@+id/tab_thong_ke_hinh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hinh_thong_ke"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tab_thong_ke_chu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_thong_ke"
                android:textColor="@color/chu_mo"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_cai_dat"
            style="@style/MucTab">

            <TextView
                android:id="@+id/tab_cai_dat_hinh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hinh_cai_dat"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tab_cai_dat_chu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_cai_dat"
                android:textColor="@color/chu_mo"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_may"
            style="@style/MucTab">

            <TextView
                android:id="@+id/tab_may_hinh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hinh_khoa_may"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tab_may_chu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_may"
                android:textColor="@color/chu_mo"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
