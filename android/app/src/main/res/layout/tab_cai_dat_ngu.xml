<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingLeft="11dp"
    android:paddingTop="10dp"
    android:paddingRight="11dp"
    android:paddingBottom="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Google Sheets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/the"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                style="@style/Nhom"
                android:text="@string/dong_bo_google_sheets" />

            <TextView
                style="@style/Nhan"
                android:layout_marginTop="9dp"
                android:text="@string/nhan_url" />

            <EditText
                android:id="@+id/o_url"
                style="@style/O"
                android:hint="@string/mau_url"
                android:inputType="textUri"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/nut_kiem_tra_url"
                    style="@style/NutPhu"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/nut_kiem_tra" />

                <Button
                    android:id="@+id/nut_luu_url"
                    style="@style/NutChinh"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/nut_luu_url" />
            </LinearLayout>

            <TextView
                android:id="@+id/tin_ket_noi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/chua_kiem_tra"
                android:textColor="@color/chu_rat_mo"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Mốc thưởng phạt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/the"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                style="@style/Nhom"
                android:text="@string/moc_thuong_phat" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/goi_y_moc"
                android:textColor="@color/chu_rat_mo"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:text="@string/cot_truoc"
                    android:textColor="@color/chu_rat_mo"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:text="@string/cot_tien"
                    android:textColor="@color/chu_rat_mo"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:text="@string/cot_thong_diep"
                    android:textColor="@color/chu_rat_mo"
                    android:textSize="11sp" />

                <View
                    android:layout_width="44dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ds_moc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/nut_them_moc"
                style="@style/NutPhu"
                android:layout_marginTop="8dp"
                android:text="@string/nut_them_moc" />

            <TextView
                style="@style/Nhan"
                android:layout_marginTop="16dp"
                android:text="@string/nhan_phat_moi_gio" />

            <EditText
                android:id="@+id/o_phat_vuot"
                style="@style/O"
                android:inputType="numberSigned" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Nhan"
                        android:text="@string/nhan_truoc_gio_nay" />

                    <TextView
                        android:id="@+id/o_truoc_gio"
                        style="@style/O"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Nhan"
                        android:text="@string/nhan_mat_chuoi_sau" />

                    <TextView
                        android:id="@+id/o_mat_chuoi"
                        style="@style/O"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Mốc chuỗi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/the"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                style="@style/Nhom"
                android:text="@string/thuong_moc_chuoi" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/goi_y_moc_chuoi"
                android:textColor="@color/chu_rat_mo"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/ds_moc_chuoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/nut_them_moc_chuoi"
                style="@style/NutPhu"
                android:layout_marginTop="8dp"
                android:text="@string/nut_them_moc_chuoi" />
        </LinearLayout>

        <!-- Chuẩn bị ngủ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/the"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                style="@style/Nhom"
                android:text="@string/cac_buoc_chuan_bi" />

            <LinearLayout
                android:id="@+id/ds_buoc_sua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/nut_them_buoc"
                style="@style/NutPhu"
                android:layout_marginTop="8dp"
                android:text="@string/nut_them_buoc" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Nhan"
                        android:text="@string/nhan_thuong_thoi_quen" />

                    <EditText
                        android:id="@+id/o_thuong_thoi_quen"
                        style="@style/O"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Nhan"
                        android:text="@string/nhan_nhac_luc" />

                    <TextView
                        android:id="@+id/o_nhac_luc"
                        style="@style/O"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Nhan"
                        android:text="@string/nhan_nhac_sang_luc" />

                    <TextView
                        android:id="@+id/o_nhac_sang_luc"
                        style="@style/O"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:hint="@string/nhac_sang_tat"
                        android:textColorHint="@color/chu_rat_mo" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/nhac_sang_giai_thich"
                android:textColor="@color/chu_rat_mo"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/nut_luu_ngu"
            style="@style/NutChinh"
            android:layout_marginTop="16dp"
            android:text="@string/nut_luu_cai_dat_ngu" />

        <Button
            android:id="@+id/nut_quyen_thong_bao"
            style="@style/NutPhu"
            android:layout_marginTop="10dp"
            android:text="@string/nut_quyen_thong_bao" />

        <!-- Phiên bản và cập nhật -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/the"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                style="@style/Nhom"
                android:text="@string/nhom_cap_nhat" />

            <TextView
                android:id="@+id/tin_cap_nhat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/chu"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/goi_y_cap_nhat"
                android:textColor="@color/chu_rat_mo"
                android:textSize="12sp" />

            <Button
                android:id="@+id/nut_cap_nhat"
                style="@style/NutPhu"
                android:layout_marginTop="10dp"
                android:text="@string/nut_kiem_tra_cap_nhat" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
