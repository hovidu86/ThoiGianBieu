<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ một đêm đúng giờ: vạch màu bên trái như PWA. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/xanh_la" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nen_the" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/vach" />
        </shape>
    </item>
</layer-list>
